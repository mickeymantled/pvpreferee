# Local development template. Copy to .env; never commit credentials.
# Real historical fixture CAs were not supplied. Keys alone do not provide the
# missing complete historical ledger or chain-endorsement verification adapters.
DATABASE_URL=
HELIUS_API_KEY=
HELIUS_RPC_URL=
BIRDEYE_API_KEY=
INGEST_TIMEOUT_MS=10000
PUMP_API_BASE_URL=https://frontend-api-v3.pump.fun
BIRDEYE_API_BASE_URL=https://public-api.birdeye.so

# Source lookup uses a separate token from the bot's OAuth user access token.
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
SOURCE_AUTHORITIES=[]

# Single administrator; hash a password using pnpm --filter @pvp/web admin:hash.
# Production requires an exact HTTPS APP_ORIGIN and a shared Redis REST backend.
APP_ORIGIN=http://localhost:3000
ADMIN_EMAIL=
SOURCE_ADMIN_ACTOR=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
# Optional trusted-ingress signing key; unsigned clients share a global bucket.
RATE_LIMIT_CLIENT_SECRET=
WEB_HOST=127.0.0.1
PORT=3000

# X worker: dry-run reads X and may save rulings, but never uploads/posts.
# Sending requires BOT_SEND=true and a real public HTTPS BOT_PUBLIC_BASE_URL.
X_USER_ACCESS_TOKEN=
BOT_PUBLIC_BASE_URL=http://localhost:3000
BOT_USERNAME=pvpreferee
BOT_SEND=false
BOT_RULEBOOK_VERSION=v1
# Omit optional overrides to use defaults. Do not set these to empty strings.
# BOT_STATE_PATH=/absolute/persistent/path/dry-run.json
# BOT_SINCE_ID=EXCLUSIVE_INITIAL_POST_ID
# BOT_POLL_MS=60000
# BOT_HTTP_TIMEOUT_MS=15000
# BOT_HTTP_RETRIES=3
# BOT_BACKOFF_MS=1000
# BOT_MAX_BACKOFF_MS=60000
# BOT_REQUEST_INTERVAL_MS=1000
# BOT_PIPELINE_TIMEOUT_MS=120000
# BOT_SHUTDOWN_MS=30000
# BOT_PAGE_SIZE=100
# BOT_PAGES_PER_TICK=10
# BOT_JOBS_PER_TICK=20
# BOT_MAX_STORED_MENTIONS=100000
# BOT_JOB_ATTEMPTS=3
# BOT_QUOTA_WINDOW_MS=86400000
# BOT_REPLY_QUOTA=100
# BOT_AUTHOR_QUOTA=3
# BOT_REPLY_INTERVAL_MS=60000

# Optional reviewed operator-owned module; default warming reports unsupported.
# WARMING_ADAPTER_MODULE=/absolute/path/to/reviewed-adapter.ts
# WARM_AT=2026-10-28T12:00:00.000Z

# Opt-in live provider checks: no fallback or guessed contract addresses.
RUN_INTEGRATION=0
FIXTURE_KIMCHI_CA=
FIXTURE_INVISIBLE_CAT_CA=
FIXTURE_SOLCAT_CA=
FIXTURE_ROBOTAXI_CA=
# Synthetic database verification must point to an isolated test database.
# TEST_DATABASE_URL=
# PVP_ALLOW_SYNTHETIC_DB=1
