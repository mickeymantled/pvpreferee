{
  "name": "@pvp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev",
    "build": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next build",
    "start": "node --env-file-if-exists=../../.env scripts/start.mjs",
    "admin:hash": "node --env-file-if-exists=../../.env --import tsx src/cli/hash-password.ts",
    "cache:warm": "node --env-file-if-exists=../../.env --import tsx src/cli/warm.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. apps/web",
    "lint": "eslint ."
  },
  "dependencies": {
    "@pvp/shared": "workspace:*",
    "@pvp/config": "workspace:*",
    "@pvp/pipeline": "workspace:*",
    "@pvp/source": "workspace:*",
    "@pvp/ingest": "workspace:*",
    "@pvp/card": "workspace:*",
    "@pvp/rules": "workspace:*",
    "@solana/addresses": "^8.5.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "@resvg/resvg-js": "2.6.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
